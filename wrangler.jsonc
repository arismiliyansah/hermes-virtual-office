{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-virtual-office",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-office"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE_HUB",
        "class_name": "OfficeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OfficeHub"]
    }
  ],
  // Dev-only values kept so `wrangler dev` and the test harness run without
  // extra setup. The Worker fails closed (503) on non-localhost hosts while
  // SESSION_SECRET is empty or "dev-secret"; production must override these
  // with `wrangler secret put`.
  "vars": {
    "HERMES_ORIGIN": "https://hermes.example-tunnel.dev",
    "HERMES_HMAC_SECRET": "dev-hmac-secret",
    "SESSION_SECRET": "dev-secret"
  }
}
